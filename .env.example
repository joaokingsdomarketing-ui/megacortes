# Copie para .env e preencha. Sem nenhuma chave, o MegaCortes funciona só com a
# seleção heurística (palavras-chave + energia do áudio) — gratuito, mas menos esperto.

# Provedor de LLM (opcional): gemini | openai | anthropic | openrouter | ollama | none
LLM_PROVIDER=gemini

GEMINI_API_KEY=
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
# OPENROUTER_API_KEY=

# --- Interface web ---------------------------------------------------------
# Permite acesso ao VPS pelo IP ou domínio:
MEGACORTES_ALLOWED_HOSTS=*
# Senha opcional para acessar o painel (se quiser proteger):
# MEGACORTES_PASSWORD=minhasenha123
MEGACORTES_MAX_UPLOAD_MB=8192
