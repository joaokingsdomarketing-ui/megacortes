# Copie para .env e preencha. Sem nenhuma chave, o MegaCortes funciona só com a
# seleção heurística (palavras-chave + energia do áudio) — gratuito, mas menos esperto.

# Provedor de LLM (opcional): gemini | openai | anthropic | openrouter | ollama | none
# Se vazio, usa o primeiro que tiver chave abaixo.
LLM_PROVIDER=gemini

GEMINI_API_KEY=
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
# OPENROUTER_API_KEY=

# LLM local (grátis, usa sua máquina): LLM_PROVIDER=ollama
# OLLAMA_BASE_URL=http://localhost:11434/v1

# Troca o modelo padrão do provedor
# LLM_MODEL=

# --- Interface web ---------------------------------------------------------
# Só preencha se for abrir o app para outros computadores da rede/servidor:
# MEGACORTES_PASSWORD=troque-esta-senha
# MEGACORTES_ALLOWED_HOSTS=meu-servidor.exemplo.com   # (ou * )
# MEGACORTES_MAX_UPLOAD_MB=8192
# Se o YouTube pedir login ("confirm you're not a bot"), exporte os cookies para um
# arquivo cookies.txt (extensão "Get cookies.txt") e aponte aqui:
# MEGACORTES_COOKIES=/data/cookies.txt
